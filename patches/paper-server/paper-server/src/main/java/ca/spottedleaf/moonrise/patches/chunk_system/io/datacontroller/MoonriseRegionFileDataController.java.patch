+package ca.spottedleaf.moonrise.patches.chunk_system.io.datacontroller;
+
+import ca.spottedleaf.concurrentutil.executor.PrioritisedExecutor;
+import ca.spottedleaf.moonrise.patches.chunk_system.io.ChunkSystemRegionFileStorage;
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import ca.spottedleaf.moonrise.patches.chunk_system.storage.MoonriseRegionFileStorageAccess;
+import java.io.IOException;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.storage.RegionFileStorage;
+
+/** Shared chunk/POI/entity controller; the world supplies each storage and the native executors. */
+public final class MoonriseRegionFileDataController extends MoonriseRegionFileIO.RegionDataController {
+    private final RegionFileStorage storage;
+    private final ChunkSystemRegionFileStorage operations;
+
+    public MoonriseRegionFileDataController(RegionFileStorage storage, MoonriseRegionFileIO.RegionFileType type,
+                                           PrioritisedExecutor io, PrioritisedExecutor compression) {
+        super(type, io, compression);
+        this.storage = java.util.Objects.requireNonNull(storage);
+        this.operations = (Object) storage instanceof ChunkSystemRegionFileStorage nativeStorage
+            ? nativeStorage : new MoonriseRegionFileStorageAccess(storage);
+    }
+
+    @Override public RegionFileStorage getCache() { return this.storage; }
+    @Override public String getDebugName() { return this.storage.info().level() + "/" + this.storage.info().type(); }
+
+    @Override public WriteData startWrite(int x, int z, CompoundTag data) throws IOException {
+        if (this.type == MoonriseRegionFileIO.RegionFileType.ENTITY_DATA && data != null) {
+            ChunkPos stored = data.read("Position", ChunkPos.CODEC).orElse(null);
+            if (stored != null && !stored.equals(new ChunkPos(x, z))) {
+                throw new IllegalArgumentException("Entity data position " + stored + " differs from target " + new ChunkPos(x, z));
+            }
+        }
+        return this.operations.moonrise$startWrite(x, z, data);
+    }
+    @Override public void finishWrite(int x, int z, WriteData data) throws IOException {
+        this.operations.moonrise$finishWrite(x, z, data);
+    }
+    @Override public ReadData readData(int x, int z) throws IOException {
+        return this.operations.moonrise$readData(x, z);
+    }
+    @Override public CompoundTag finishRead(int x, int z, ReadData data) throws IOException {
+        return this.operations.moonrise$finishRead(x, z, data);
+    }
+}

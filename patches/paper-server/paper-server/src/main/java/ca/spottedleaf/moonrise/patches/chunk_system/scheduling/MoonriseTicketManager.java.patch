+    protected MoonriseTicketManager(int regionShift, int maxSchedulingRadius, ReentrantAreaLock schedulingLock) {
+        if (regionShift < 0 || regionShift > 30) throw new IllegalArgumentException("Region shift: " + regionShift);
+        this.regionShift = regionShift;
+        this.lockShift = Math.max(regionShift, ThreadedTicketLevelPropagator.SECTION_SHIFT);
+        this.schedulingLockArea = java.util.Objects.requireNonNull(schedulingLock);
+        if (schedulingLock.coordinateShift != this.lockShift) throw new IllegalArgumentException("Scheduling lock shift must be " + this.lockShift);
+        this.ticketLockArea = new ReentrantAreaLock(this.lockShift);
+        this.ticketLevelPropagator = new ThreadedTicketLevelPropagator<>(maxSchedulingRadius) {
+            @Override protected void processLevelUpdates(Long2ByteLinkedOpenHashMap updates) {
+                MoonriseTicketManager.this.processLevelUpdates(updates);
+            }
+            @Override protected void processSchedulingUpdates(Long2ByteLinkedOpenHashMap updates, List<T> tasks, List<H> statuses) {
+                MoonriseTicketManager.this.processSchedulingUpdates(updates, tasks, statuses);
+            }
+        };
+    }
+
+    /** Called with ticket locks held; values are propagator levels and may be filtered before scheduling. */
+    protected abstract void processLevelUpdates(Long2ByteLinkedOpenHashMap updates);
+    /** Called with ticket and scheduling locks held, matching the native holder manager contract. */
+    protected abstract void processSchedulingUpdates(Long2ByteLinkedOpenHashMap updates, List<T> tasks, List<H> statuses);
+    /** Deliver status changes and start tasks after releasing the ticket lock. */
+    protected abstract void afterTicketUpdates(List<T> tasks, List<H> statuses);
+    /** Tick-thread owner drains pending full-status transitions here. */
+    protected abstract boolean processPendingFullUpdates();

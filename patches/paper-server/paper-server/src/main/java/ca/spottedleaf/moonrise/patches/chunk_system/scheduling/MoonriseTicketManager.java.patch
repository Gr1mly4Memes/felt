+/**
+ * Paper's ticket storage, expiry, counters and propagation dispatch extracted from ChunkHolderManager.
+ * The native holder owner supplies level/status callbacks and starts tasks after the ticket lock is released.
+ */
+public abstract class MoonriseTicketManager<T, H> {
+    public static final int MAX_TICKET_LEVEL = ChunkLevel.MAX_LEVEL;
+    private static final long NO_TIMEOUT_MARKER = Long.MIN_VALUE;

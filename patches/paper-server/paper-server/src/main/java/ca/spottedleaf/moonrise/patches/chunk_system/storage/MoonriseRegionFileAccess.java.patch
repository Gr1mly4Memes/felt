+    private static final class DetachedBuffer extends ByteArrayOutputStream {
+        private final ChunkPos pos;
+        DetachedBuffer(ChunkPos pos, int compression) {
+            this.pos = pos;
+            this.writeBytes(new byte[] {0, 0, 0, 0, (byte) compression});
+        }
+        void commit(RegionFile file) throws IOException {
+            ByteBuffer data = ByteBuffer.wrap(this.buf, 0, this.count);
+            data.putInt(0, this.count - Integer.BYTES);
+            file.write(this.pos, data);
+        }
+    }
+
+    private static void writeFully(FileChannel file, ByteBuffer data, long position) throws IOException {
+        while (data.hasRemaining()) {
+            int written = file.write(data, position);
+            if (written <= 0) throw new IOException("Region file write made no progress");
+            position += written;
+        }
+    }

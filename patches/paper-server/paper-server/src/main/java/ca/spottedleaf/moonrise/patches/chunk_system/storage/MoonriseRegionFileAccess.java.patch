+    private DataInputStream readInput(ChunkPos pos, boolean allowRecovery) throws IOException {
+        synchronized (this.region) {
+            DataInputStream input = this.region.getChunkDataInputStream(pos);
+            int offset = this.region.offsets.get((pos.x() & 31) | ((pos.z() & 31) << 5));
+            ByteBuffer compression = ByteBuffer.allocate(1);
+            final boolean hasCompression;
+            try {
+                hasCompression = offset != 0 && this.region.file.read(compression, ((long) (offset >>> 8) << 12) + 4L) == 1;
+            } catch (IOException | RuntimeException | Error failure) {
+                if (input != null) try { input.close(); } catch (IOException closeFailure) { failure.addSuppressed(closeFailure); }
+                throw failure;
+            }
+            if (input != null) {
+                return hasCompression && (compression.get(0) & 128) != 0
+                    ? new ca.spottedleaf.moonrise.patches.chunk_system.util.stream.ExternalChunkStreamMarker(input) : input;
+            }
+            if (offset == 0 || !allowRecovery || !this.canRecalcHeader()
+                || (hasCompression && (compression.get(0) & 127) == RegionFileVersion.VERSION_CUSTOM.getId())) return null;
+            return this.moonrise$recalculateHeader() ? this.readInput(pos, false) : null;
+        }
+    }

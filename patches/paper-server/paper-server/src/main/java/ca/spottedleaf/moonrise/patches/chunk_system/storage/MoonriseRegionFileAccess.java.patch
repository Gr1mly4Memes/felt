+    /** Detect constructor repairs by comparing the original on-disk header with its loaded offsets. */
+    public void recoverHeaderIfNeeded() throws IOException {
+        synchronized (this.region) {
+            if (!this.canRecalcHeader()) return;
+            ByteBuffer header = ByteBuffer.allocate(4096);
+            int read = this.readFully(header, 0L);
+            for (int i = 0; i < read / Integer.BYTES; i++) {
+                if (header.getInt(i * Integer.BYTES) != this.region.offsets.get(i)) {
+                    this.moonrise$recalculateHeader();
+                    return;
+                }
+            }
+        }
+    }

+    public static WriteData prepareWrite(RegionFile region, CompoundTag data, ChunkPos pos) throws IOException {
+        // Like Paper's detached ChunkBuffer, closing the compressor only finishes the buffer.
+        // The region file passed at commit time may differ after cache eviction and reopening.
+        DetachedBuffer buffer = new DetachedBuffer(pos, region.version.getId());
+        DataOutputStream output = new DataOutputStream(region.version.wrap(buffer));
+        return new WriteData(data, WriteData.WriteResult.WRITE, output, buffer::commit);
+    }

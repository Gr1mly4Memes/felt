+    private static final class UnpackProgress {
+
+        private static final int WIDTH = 30;
+
+        private final int total;
+        private int completed;
+
+        UnpackProgress(int total) {
+            this.total = Math.max(total, 1);
+        }
+
+        synchronized void complete() {
+            this.completed++;
+            render();
+        }
+
+        synchronized void finish() {
+            this.completed = this.total;
+            render();
+            System.out.print("\n");
+            System.out.flush();
+        }
+
+        private void render() {
+            int percent = (int) (this.completed * 100L / this.total);
+            int filled = (int) (this.completed * (long) WIDTH / this.total);
+            String bar = "=".repeat(filled) + " ".repeat(WIDTH - filled);
+            System.out.print(String.format("\rUnpacking libraries [%s] %3d%% (%d/%d)   ", bar, percent, this.completed, this.total));
+            System.out.flush();
+        }
+    }
